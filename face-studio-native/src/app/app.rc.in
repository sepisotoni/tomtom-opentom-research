#include <windows.h>

// RT_MANIFEST (24) with CREATEPROCESS_MANIFEST_RESOURCE_ID (1)
1 24 "@FS_MANIFEST_PATH@"

1 VERSIONINFO
FILEVERSION @FS_VERSION_COMMA@
PRODUCTVERSION @FS_VERSION_COMMA@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "TomTom Face Studio (native)"
      VALUE "FileVersion", "@FS_VERSION_FULL@"
      VALUE "InternalName", "TomTomFaceStudio"
      VALUE "OriginalFilename", "TomTomFaceStudio.exe"
      VALUE "ProductName", "TomTom Face Studio"
      VALUE "ProductVersion", "@FS_VERSION_LABEL@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
