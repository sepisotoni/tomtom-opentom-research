{
  "file_format": "ttproj",
  "version": 1,
  "project": {
    "metadata": {
      "name": "Cyberpunk Retro",
      "version": "1.0.0",
      "author": "TomTom Face Studio"
    },
    "background_color": "#0A0A1A",
    "canvas": {
      "width": 320,
      "height": 240
    },
    "elements": [
      {
        "id": "main_clock",
        "type": "digital_time",
        "format": "HH:MM",
        "x": 65,
        "y": 25,
        "width": 190,
        "height": 55,
        "color": "#84EBFF",
        "font_size": 48,
        "is_12h": false,
        "rule": null
      },
      {
        "id": "date_line",
        "type": "date",
        "x": 95,
        "y": 78,
        "width": 130,
        "height": 22,
        "color": "#FF7341",
        "font_size": 18,
        "rule": null
      },
      {
        "id": "bat_warning",
        "type": "status_icon",
        "icon_type": "battery_low",
        "x": 285,
        "y": 10,
        "width": 24,
        "height": 24,
        "color": "#FF4444",
        "rule": "battery_low"
      },
      {
        "id": "gps_indicator",
        "type": "status_icon",
        "icon_type": "gps_fix",
        "x": 10,
        "y": 10,
        "width": 24,
        "height": 24,
        "color": "#00FFCC",
        "rule": "gps_fix"
      },
      {
        "id": "weather_alert",
        "type": "status_icon",
        "icon_type": "weather_unavailable",
        "x": 40,
        "y": 10,
        "width": 24,
        "height": 24,
        "color": "#FFAA00",
        "rule": "weather_unavailable"
      }
    ],
    "rules": [
      {
        "name": "battery_low",
        "signal": "battery_percent",
        "op": "<=",
        "value": 20
      },
      {
        "name": "gps_fix",
        "signal": "gps_status",
        "op": "==",
        "value": 1
      },
      {
        "name": "weather_unavailable",
        "signal": "weather_status",
        "op": "==",
        "value": 0
      }
    ]
  },
  "canvas_png_b64": ""
}