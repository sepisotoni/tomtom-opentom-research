--- a/drivers/barcelona/gpio/gpio.c
+++ b/drivers/barcelona/gpio/gpio.c
@@ -58,7 +58,16 @@
 #define GPIO_POLL_DELAY (HZ / 5)     /* 5 polls / sec */
 #define GPIO_PREPIC_TIMEOUT (10 * 5) /* 10 seconds */
-#define GPIO_SHUTDOWN_TIMEOUT (2)    /* 400 ms. Actual event is sent between 400-600 ms*/
+/*
+ * Long-press power off: requires holding power button continuously for ~9.0 seconds.
+ * Must trigger just before GPIO_PREPIC_TIMEOUT (10 seconds) so user space can
+ * perform a graceful unmount and shutdown before gpio_prepic_suicide() / PIC reset.
+ * Short button presses (< 9.0s) will be released before the timer expires,
+ * avoiding accidental shutdown while preserving emergency PIC reset on freeze.
+ */
+#define GPIO_SHUTDOWN_TIMEOUT (9 * 5) /* 45 ticks @ 5 Hz = 9.0 seconds */
 
 /* Forward declarations */
 static void gpio_status_poll( void *data );
@@ -443,10 +452,10 @@
 	// Button pressed?
 	if (IO_GetInput(ON_OFF)) {
-		// Count down timer when button was released
+		// Count down timer while button remains pressed
 		if (power_button_timer > 0)
 		{
 			power_button_timer--;
 		}
 		else
 		if (power_button_timer == 0)
 		{
 			// Disable timer to wait for button release
 			power_button_timer = -1;
-			// Send message to application to shut down
+			// Send message to application to shut down (sustained long press)
 			gpio_hw_status.u8InputStatus |= ONOFF_MASK;
 		}
 	} else {
-		// Enable running timer when button is released (wait 1/5 second)
+		// Reset countdown when button is released before timeout
 		power_button_timer = GPIO_SHUTDOWN_TIMEOUT;
 	}
